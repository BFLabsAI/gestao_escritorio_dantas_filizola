{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "jsx": "preserve",
    "jsxImportSource": "react",
    "skipLibCheck": true,
    "paths": {}
  },
  "exclude": ["../..", "node_modules"]
}
